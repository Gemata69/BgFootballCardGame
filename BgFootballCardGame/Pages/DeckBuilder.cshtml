    ];

    // 3. Сливане на базите
    const allCardsDatabase = [
        ...playerDatabase.map(player => ({ ...player, type: "Footballer" })),
        ...specialCardsDatabase
    ];

    // 2. ИНВЕНТАР И МОНЕТИ
    let myInventory = JSON.parse(localStorage.getItem("myInventory")) || [];
    let currentDeck = JSON.parse(localStorage.getItem("myCustomDeck")) || [];

    // 3. ГЕНЕРИРАНЕ НА СТАРТОВ ПАКЕТ (Ако е първо влизане)
    if (myInventory.length === 0) {
        const levskiPlayers = allCardsDatabase.filter(c => c.team === "Левски");
        const randomLevski = levskiPlayers[Math.floor(Math.random() * levskiPlayers.length)];
        
        const otherPlayers = allCardsDatabase.filter(c => c.type === "Footballer" && c.team !== "Левски");
        const shuffledOthers = otherPlayers.sort(() => 0.5 - Math.random()).slice(0, 25);
        
        const starterSpellsTraps = ["Penalty", "Scout", "Assist", "Assist", "Assist", "Tackle", "Tackle", "Offside", "Offside", "Offside", "Offside", "Owngoal", "Owngoal", "Owngoal"];
        
        myInventory.push({ ...randomLevski });
        shuffledOthers.forEach(p => myInventory.push({ ...p }));
        starterSpellsTraps.forEach(name => {
            const card = specialCardsDatabase.find(c => c.name === name);
            if (card) myInventory.push({ ...card });
        });

        localStorage.setItem("myInventory", JSON.stringify(myInventory));
        localStorage.setItem("myCoins", 100);
        alert("🎁 Стартов пакет генериран! Имаш 26 футболиста и 14 магии/капани.");
    }

    // 4. ИНИЦИАЛИЗАЦИЯ
    applyFilters();
    renderDeck();

    // 5. ФИЛТРИ И РЕНДЕРИРАНЕ
    function applyFilters() {
        const selectedType = document.getElementById("filter-type").value;
        const selectedTeam = document.getElementById("filter-team").value;
        renderCollection(selectedType, selectedTeam);
    }

    function renderCollection(filterType, filterTeam) {
        const grid = document.getElementById("collection-grid");
        grid.innerHTML = "";

        const cardCounts = {};
        myInventory.forEach(c => cardCounts[c.name] = (cardCounts[c.name] || 0) + 1);
        
        const uniqueCards = [...new Map(myInventory.map(item => [item.name, item])).values()];

        const filteredCards = uniqueCards.filter(card => {
            let matchType = (filterType === "all" || card.type === filterType);
            let matchTeam = (filterTeam === "all" || card.team === filterTeam || card.type !== "Footballer");
            return matchType && matchTeam;
        });

        filteredCards.forEach(card => {
            let cssClass = card.type === "Footballer" ? "bg-footballer" : card.type === "Spell" ? "bg-spell" : "bg-trap";
            let ownedQuantity = cardCounts[card.name];
            
            const cardEl = document.createElement("div");
            cardEl.className = `mini-card ${cssClass}`;
            cardEl.innerHTML = card.type === "Footballer" ? `
                <div class="mini-title">${card.name}</div>
                <div style="font-size: 0.65rem; text-align: center; color: black; background: #ffd700; font-weight: bold;">${card.team}</div>
                <div style="flex-grow: 1; position: relative;">
                    <img src="${card.imgUrl}" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/Maicon.png'"/>
                    <div style="position: absolute; bottom: 0; right: 0; background: rgba(0,0,0,0.8); padding: 2px 5px; font-weight: bold;">x${ownedQuantity}</div>
                </div>
                <div class="mini-stats"><span>A:${card.baseAtk}</span><span>D:${card.baseDef}</span><span>C:${card.baseCon}</span></div>
            ` : `
                <div class="mini-title" style="background: rgba(0,0,0,0.5); color:white;">${card.name}</div>
                <div style="flex-grow: 1; position: relative;">
                    <img src="${card.imgUrl}" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/search.png'"/>
                    <div style="position: absolute; bottom: 0; right: 0; background: rgba(0,0,0,0.8); padding: 2px 5px; font-weight: bold;">x${ownedQuantity}</div>
                </div>
                <div class="mini-desc">${card.desc}</div>
            `;
            cardEl.onclick = () => addCardToDeck(card);
            grid.appendChild(cardEl);
        });
    }

    // 6. ЛОГИКА ЗА ДЕК
    function addCardToDeck(card) {
        let countInDeck = currentDeck.filter(c => c.name === card.name).length;
        let ownedCount = myInventory.filter(c => c.name === card.name).length;

        if (countInDeck >= ownedCount) { alert("Нямаш повече копия в инвентара!"); return; }
        if (currentDeck.length >= 40) { alert("Пълен дек!"); return; }

        currentDeck.push(card);
        renderDeck();
    }

    function removeCardFromDeck(index) {
        currentDeck.splice(index, 1);
        renderDeck();
    }

    function renderDeck() {
        const container = document.getElementById("deck-items-container");
        container.innerHTML = "";
        document.getElementById("current-count").innerText = currentDeck.length;
        currentDeck.forEach((card, index) => {
            const item = document.createElement("div");
            item.className = "deck-item";
            item.innerHTML = `<div>${card.name}</div><button class="remove-btn" onclick="removeCardFromDeck(${index})">X</button>`;
            container.appendChild(item);
        });
    }

    function saveDeck() {
        localStorage.setItem("myCustomDeck", JSON.stringify(currentDeck));
        alert("Дека е записан!");
    }
</script>

</body>
</html>