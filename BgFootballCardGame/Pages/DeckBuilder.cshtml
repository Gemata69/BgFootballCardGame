@page
@model BgFootballCardGame.Pages.DeckBuilderModel
@{
    ViewData["Title"] = "Сглобяване на тесте";
    Layout = null;
}
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <title>Deck Builder - BG Football Card</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background-color: #0a0a0a;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: white;
        }

        .builder-wrapper {
            display: flex;
            width: 100vw;
            height: 100vh;
        }

        .collection-section {
            width: 65vw;
            height: 100%;
            background: linear-gradient(180deg, #141414, #0b0b0b);
            border-right: 3px solid #d4af37;
            display: flex;
            flex-direction: column;
            box-sizing: border-box;
            padding: 20px;
        }

        .cards-grid {
            flex-grow: 1;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
            gap: 15px;
            overflow-y: auto;
            padding-right: 10px;
        }

        .deck-section {
            width: 35vw;
            height: 100%;
            background: #0d0d0d;
            display: flex;
            flex-direction: column;
            padding: 20px;
            box-sizing: border-box;
        }

        .deck-header {
            border-bottom: 2px solid #333;
            padding-bottom: 15px;
            margin-bottom: 15px;
        }

        .deck-counter {
            font-size: 1.5rem;
            color: #ffd700;
            font-weight: bold;
        }

        .deck-list {
            flex-grow: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 8px;
            padding-right: 5px;
        }

        .deck-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 12px;
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 4px;
        }

        .deck-item-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .badge-type {
            font-size: 0.7rem;
            padding: 2px 6px;
            border-radius: 3px;
            font-weight: bold;
        }

        .remove-btn {
            background: #dc3545;
            border: none;
            color: white;
            padding: 4px 8px;
            cursor: pointer;
            border-radius: 3px;
            font-weight: bold;
        }

        .remove-btn:hover { background: #bd2130; }

        .action-btns {
            margin-top: 15px;
            display: flex;
            gap: 10px;
        }

        .btn-action {
            flex-grow: 1;
            padding: 15px;
            font-size: 1.1rem;
            font-weight: bold;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-transform: uppercase;
            text-align: center;
            text-decoration: none;
        }

        .btn-save { background: #28a745; color: white; }
        .btn-save:hover { background: #218838; }
        .btn-back { background: #6c757d; color: white; }
        .btn-back:hover { background: #5a6268; }

        .mini-card {
            width: 120px;
            height: 200px;
            border-radius: 6px;
            border: 2px solid #444;
            cursor: pointer;
            padding: 4px;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: 0.2s;
            position: relative;
        }

        .mini-card:hover {
            transform: scale(1.05);
            border-color: #ffd700;
            box-shadow: 0 0 15px rgba(255, 215, 0, 0.5);
            z-index: 10;
        }

        .mini-title { 
            font-size: 0.75rem; 
            font-weight: bold; 
            color: black; 
            text-align: center; 
            background: rgba(255,255,255,0.8); 
            padding: 2px 4px; 
            border-radius: 2px; 
            white-space: nowrap; 
            overflow: hidden; 
            text-overflow: ellipsis; 
            width: 100%;
            box-sizing: border-box;
        }        
        .mini-desc { font-size: 0.55rem; color: #fff; text-align: left; line-height: 1.1; background: rgba(0,0,0,0.6); padding: 2px; border-radius: 2px; flex-grow: 1; overflow: hidden; }
        .mini-stats { font-size: 0.65rem; font-weight: bold; color: black; display: flex; justify-content: space-around; width: 100%; background: white; padding: 2px 0; border-radius: 2px; margin-top: 2px; }

        .bg-footballer { background: linear-gradient(135deg, #ffd700, #b8860b); color: #222; }
        .bg-spell { background: linear-gradient(135deg, #13547a, #80d0c7); color: white; }
        .bg-trap { background: linear-gradient(135deg, #4a00e0, #8e2de2); color: white; }
    </style>
</head>
<body>

<div class="builder-wrapper">
    <div class="collection-section">
        <h2 style="margin-top: 0; color: #ffd700;">КОЛЕКЦИЯ КАРТИ</h2>
        
        <div class="deck-filters" style="display: flex; gap: 15px; margin-bottom: 20px; background: rgba(0,0,0,0.4); padding: 10px; border-radius: 5px; border: 1px solid #ffd700;">
            <div style="flex: 1;">
                <label style="color: white; font-size: 1.4vh; display: block; margin-bottom: 5px;">Тип карта:</label>
                <select id="filter-type" onchange="applyFilters()" style="width: 100%; padding: 8px; background: #222; color: white; border: 1px solid #ffd700; border-radius: 3px; cursor: pointer; font-weight: bold; outline: none;">
                    <option value="all">Всички карти</option>
                    <option value="Footballer">⚽ Футболисти</option>
                    <option value="Spell">✨ Магии</option>
                    <option value="Trap">🚩 Капани</option>
                </select>
            </div>
            <div id="team-filter-wrapper" style="flex: 1;">
                <label style="color: white; font-size: 1.4vh; display: block; margin-bottom: 5px;">Отбор:</label>
                <select id="filter-team" onchange="applyFilters()" style="width: 100%; padding: 8px; background: #222; color: white; border: 1px solid #ffd700; border-radius: 3px; cursor: pointer; font-weight: bold; outline: none;">
                    <option value="all">Всички отбори</option>
                    <option value="Левски">Левски</option>
                    <option value="Лудогорец">Лудогорец</option>
                    <option value="ЦСКА">ЦСКА</option>
                    <option value="Локомотив Пловдив">Локомотив Пловдив</option>
                    <option value="Ботев Пловдив">Ботев Пловдив</option>
                    <option value="Черно море">Черно море</option>
                    <option value="Славия">Славия</option>
                    <option value="Ботев Враца">Ботев Враца</option>
                    <option value="Арда">Арда</option>
                    <option value="ЦСКА 1948">ЦСКА 1948</option>
                    <option value="Дунав Русе">Дунав Русе</option>
                    <option value="Локомотив София">Локомотив София</option>
                    <option value="Септември София">Септември София</option>
                    <option value="Спартак Варна">Спартак Варна</option>
                </select>
            </div>
        </div>

        <div class="cards-grid" id="collection-grid"></div>
    </div>

    <div class="deck-section">
        <div class="deck-header">
            <h2 style="margin: 0 0 5px 0;">ТВОЯТ ДЕК</h2>
            <div class="deck-counter"><span id="current-count">0</span> / 40 КАРТИ</div>
            <div style="font-size: 0.85rem; color: #aaa; margin-top: 5px;">
                Изискване: точно 26 футболиста и 14 магии/капани.
            </div>
        </div>

        <div class="deck-list" id="deck-items-container"></div>

        <div class="action-btns">
            <a asp-page="/Index" class="btn-action btn-back">Назад</a>
            <button class="btn-action btn-save" onclick="saveDeck()">Запази Дек</button>
        </div>
    </div>
</div>

