@page
@model BgFootballCardGame.Pages.BoardModel
@{
    ViewData["Title"] = "Игрално поле";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <title>Игрално поле - BG Football Card</title>
    <link rel="stylesheet" href="~/css/board.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/deckzone.css" asp-append-version="true" />
</head>
<body>

@* Dice screen *@
<div id="dice-overlay" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.95); z-index: 2000; display: flex; flex-direction: column; align-items: center; justify-content: center; color: white;">
    <h1 id="dice-status-text" style="color: #ffd700; margin-bottom: 40px; font-size: 2.5em; text-transform: uppercase;">Кой ще започне пръв?</h1>
    
    <div style="display: flex; align-items: center; gap: 50px; margin-bottom: 40px;">
        <div style="text-align: center;"><h3>ТИ</h3><div id="my-dice" class="dice-icon">🎲</div></div>
        <div style="font-size: 2em; color: gray;">VS</div>
        <div style="text-align: center;"><h3>ПРОТИВНИК</h3><div id="enemy-dice" class="dice-icon">🎲</div></div>
    </div>

    <button id="start-roll-btn" class="dice-btn" style="font-size: 1.5em; padding: 15px 30px;">Хвърли твоето зарче!</button>
    <h2 id="dice-final-result" style="display: none; font-size: 2em; margin-top: 20px;"></h2>
    <p id="click-to-start-hint" style="display: none; margin-top: 40px; font-size: 1.5em; color: #aaaaaa; animation: blink 1.5s infinite;">(Кликни някъде по екрана, за да започнеш рунда)</p>
</div>

@* You want a trap? *@
<div id="trap-prompt-modal" style="display: none; position: fixed; top: 30%; left: 50%; transform: translate(-50%, 0); background-color: rgba(0, 0, 0, 0.95); border: 3px solid #ff0000; border-radius: 10px; padding: 30px; text-align: center; color: white; z-index: 1500; box-shadow: 0 0 20px red;">
    <h2 style="color: #ffd700;">Времето изтече!</h2>
    <h3 id="trap-question">Имате ли поставен капан, който искате да активирате?</h3>
    <div style="margin-top: 20px;">
        <button id="btn-trap-yes" class="dice-btn" style="background-color: #28a745; margin-right: 15px;">ДА, активирай</button>
        <button id="btn-trap-no" class="dice-btn" style="background-color: #dc3545;">НЕ</button>
    </div>
</div>

@* Choose a spell *@
<div id="spell-search-modal" style="display: none; position: fixed; top: 30%; left: 50%; transform: translate(-50%, 0); background-color: rgba(19, 84, 122, 0.95); border: 3px solid #00ffff; border-radius: 10px; padding: 30px; text-align: center; color: white; z-index: 1500; box-shadow: 0 0 20px #00ffff;">
    <h2 style="color: #80d0c7;">✨ Активиран Спел! ✨</h2>
    <h3>Търсене в тестето... Каква карта искаш да изтеглиш?</h3>
    <p style="font-size: 0.9em; color: #ccc;">(След като избереш, тестето ще се размеси автоматично)</p>
    <div style="margin-top: 20px; display: flex; gap: 15px; justify-content: center;">
        <button id="btn-draw-footballer" class="dice-btn" style="background: linear-gradient(135deg, #ffd700, #d4af37); color: black; border: 1px solid white;">⚽ Футболист</button>
        <button id="btn-draw-trap" class="dice-btn" style="background: linear-gradient(135deg, #4a00e0, #8e2de2); color: white; border: 1px solid white;">🪤 Капан</button>
    </div>
</div>

@* Battle *@
<div id="battle-result-modal" style="display: none; position: fixed; top: 20%; left: 50%; transform: translate(-50%, 0); background-color: rgba(0, 0, 0, 0.9); border: 4px solid #ffd700; border-radius: 15px; padding: 30px; text-align: center; color: white; z-index: 1000; width: 600px; box-shadow: 0 0 30px black;">
    <h1 id="battle-status" style="font-size: 3em; margin: 0; text-transform: uppercase;"></h1>
    <hr style="border-color: #ffd700;" />
    <h3 id="battle-math" style="line-height: 1.5;"></h3>
    <button id="close-battle-btn" class="dice-btn" style="margin-top: 20px;">Продължи (Картите отиват на Скамейката)</button>
</div>

@* Main structure *@
<div class="game-wrapper">
    
    <div class="sidebar">
        <h1 id="round-title" style="color: white; font-size: 4vh; margin-bottom: 2vh;">РУНД 1</h1>
        <h2 id="turn-timer" style="color: #ffd700; display: none; font-size: 3vh; margin-bottom: 3vh; text-shadow: 1px 1px 2px black;">Оставащо време: 15 сек.</h2>
        
        <div id="battle-condition-banner" style="display: none; background-color: rgba(139, 0, 0, 0.8); padding: 20px; border-radius: 10px; border: 2px solid #ffd700; width: 90%;">
            <h3 style="margin: 0; text-transform: uppercase; font-size: 2vh;" id="battle-condition-text"></h3>
        </div>

        <div style="margin-top: 5vh; width: 100%; border-top: 2px solid gray; padding-top: 2vh; text-align: left;">
            <h3 style="margin-bottom: 10px;">Противниково Тесте: <span id="enemy-deck-count" style="color: #ffd700;">40</span></h3>
            <h3>Твоето Тесте: <span id="my-deck-count" style="color: #ffd700;">40</span></h3>
        </div>
    </div>

    @* 3D field *@
    <div class="board-container">
        
        @* Enenmy zone *@
        <div class="player-zone">
            <div style="display: flex; justify-content: space-between; width: 60%; align-items: center; margin-bottom: 1vh;">
                <h4 style="color: #ccc; margin: 0;">Ръка на Противника</h4>
                <div class="card-row" id="enemy-hand" style="margin: 0; transform: scale(0.6); transform-origin: right;">
                </div>
            </div>
            <h3>@Model.Game.Player2.Name - Жизнени точки: <span id="enemy-lp" style="color: #ff4444;">30</span></h3>
            
            <div style="display: flex; gap: 2vw; align-items: center; justify-content: center; width: 100%;">
                @* Enemy subs and deck *@
                <div style="display: flex; flex-direction: column; gap: 1vh;">
                    <div class="gy-zone" id="enemy-gy">СКАМЕЙКА<br/>(0)</div>
                    <div class="deck-zone">ТЕСТЕ</div>
                </div>
                
                <div class="field-3d" style="transform: rotateX(-15deg);">
                    <div class="card-row" id="enemy-back-row">
                        @for (int i = 0; i < 5; i++) { <div class="card-slot enemy-board-slot" data-slot-index="@i">Слот @(i + 1)</div> }
                    </div>
                    <div class="card-row" id="enemy-front-row">
                        @for (int i = 0; i < 5; i++) { <div class="card-slot enemy-board-slot" data-slot-index="@i">Слот @(i + 1)</div> }
                    </div>
                </div>
            </div>
        </div>

        <hr style="width: 80%; border-color: rgba(255,255,255,0.3); margin: 2vh 0;" />

        @* My zone *@
        <div class="player-zone">
            <div style="display: flex; gap: 2vw; align-items: center; justify-content: center; width: 100%;">
                
                <div class="field-3d">
                    <div class="card-row" id="my-front-row">
                        @for (int i = 0; i < 5; i++) { <div class="card-slot my-board-slot" data-slot-index="@i">Слот @(i + 1)</div> }
                    </div>
                    <div class="card-row" id="my-back-row">
                        @for (int i = 0; i < 5; i++) { <div class="card-slot my-board-slot" data-slot-index="@i">Слот @(i + 1)</div> }
                    </div>
                </div>

                @* My subs and deck *@
                <div style="display: flex; flex-direction: column; gap: 1vh;">
                    <div class="deck-zone">ТЕСТЕ</div>
                    <div class="gy-zone" id="my-gy">СКАМЕЙКА<br/>(0)</div>
                </div>
            </div>
            
            <h3 style="margin-top: 1vh;">@Model.Game.Player1.Name - Жизнени точки: <span id="my-lp" style="color: #44ff44;">30</span></h3>
        </div>

        @* My hand *@
        <div class="my-hand-wrapper">
            <div class="card-row my-hand" id="my-hand-container"></div>
        </div>

    </div>
</div>

<script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
<script src="~/js/board.js"></script>
</body>
</html>